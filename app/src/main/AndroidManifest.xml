<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Network, only for:
        - the driver's YouDrive page;
        - the offline street map's download (on the driver's tap);
        - SMHI's weather for the passenger display (one fixed place);
        - the tablet's Google map (Maps JavaScript);
        - api.nastastopp.se, the company's server: the tablet's connection, its map key, ways and
          travel times.
        Google's Routes API and mapmap.ai are reached directly only with the driver's own keys,
        while the tablet is not connected to the company's server. Nothing else is sent anywhere;
        ML Kit's usage reporting is switched off below.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!--
        Location only to name the street the vehicle is on and its speed: asked at
        "Start route", used while a route is active, never stored, logged or sent, and never given
        to the YouDrive page (its WebView has geolocation off). Never in the background.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Passenger display link: Bluetooth RFCOMM between paired devices (no internet). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Package visibility (Android 11+): Google Maps, TTS engines and the widgets a weather app offers. -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.NastaStopp"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- YouDrive in its own full-screen window (the page at the phone's real size). -->
        <activity
            android:name=".youdrive.YouDriveActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode"
            android:label="@string/youdrive_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- The street the vehicle is on, while a route is active (see StreetService). -->
        <service
            android:name=".service.StreetService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Quick Settings tile: show / hide the floating button (only the system can bind it). -->
        <service
            android:name=".overlay.OverlayTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Keeps the YouDrive page watched while Maps is in front (trip added / cancelled alerts). -->
        <!-- Reads Google Maps' remaining travel time from its navigation notification, only with the
             access the driver gives in Settings (203); only the system can bind it. -->
        <service
            android:name=".nav.MapsNavigationListener"
            android:exported="true"
            android:label="@string/maps_time_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".youdrive.YouDriveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the driver's own trip list page open to alert about added or cancelled trips" />
        </service>

        <!--
            Privacy: ML Kit's usage reporting (Google datatransport) gets no upload backend, so no
            reports are sent although the app has internet access.
        -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>

        <receiver
            android:name=".service.RouteActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".route.ExpiryReceiver"
            android:exported="false" />
    </application>
</manifest>
